+static void native_set_app_routing(JNIEnv *env, jobject thiz, jboolean enabled) {
+    /* Kotlin serializes this with start/stop and only changes it after worker join. */
+    rr_app_route_set_enabled(enabled == JNI_TRUE);
+}
+int64_t rr_jni_resolve_route(int protocol, const char *source, int source_port,
+                             const char *destination, int destination_port) {
+    JNIEnv *env = pthread_getspecific(current_jni_env);
+    jstring src, dst;
+    jlong token = -1;
+    if (!env) {
+        if ((*java_vm)->AttachCurrentThread(java_vm, &env, NULL) != JNI_OK) return -1;
+        pthread_setspecific(current_jni_env, env);
+    }
+    src = (*env)->NewStringUTF(env, source);
+    if (!src) goto fail;
+    dst = (*env)->NewStringUTF(env, destination);
+    if (!dst) { (*env)->DeleteLocalRef(env, src); goto fail; }
+    token = (*env)->CallStaticLongMethod(env, route_class, route_method,
+                                        protocol, src, source_port, dst, destination_port);
+    (*env)->DeleteLocalRef(env, src);
+    (*env)->DeleteLocalRef(env, dst);
+fail:
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        return -1;
+    }
+    return token;
+}
