+    if (!self->pcb) return 0;
+    token = rr_app_route_lookup(17, &self->pcb->remote_ip, self->pcb->remote_port,
+                                  &self->pcb->local_ip, self->pcb->local_port);
+    if (token > 0 && token == self->data.route_token) return 1;
+    /* This function runs on the one cooperative HEV worker. Removing the PCB here
+     * prevents a recycled source port from joining the old SOCKS association. */
+    udp_recv(self->pcb, NULL, NULL);
+    udp_remove(self->pcb);
+    self->pcb = NULL;
+    hev_socks5_session_terminate(HEV_SOCKS5_SESSION(self));
+    return 0;
+}
