+/* RRBOX: original-socket ownership, resolved before loopback SOCKS conversion. */
+#include <stdatomic.h>
+#include "rr-app-routing.h"
+static atomic_int routing_enabled;
+static RRAppOwnerCallback owner_callback;
+void rr_app_route_set_enabled(int enabled) {
+    atomic_store_explicit(&routing_enabled, enabled != 0, memory_order_release);
+}
+void rr_app_route_set_callback(RRAppOwnerCallback callback) { owner_callback = callback; }
+int rr_app_route_enabled(void) {
+    return atomic_load_explicit(&routing_enabled, memory_order_acquire);
+}
+int64_t rr_app_route_lookup(int protocol, const ip_addr_t *source, int source_port,
+                           const ip_addr_t *destination, int destination_port) {
+    char src[48], dst[48];
+    int64_t token;
+    if (!rr_app_route_enabled()) return 0;
+    if (!ipaddr_ntoa_r(source, src, sizeof(src)) ||
+        !ipaddr_ntoa_r(destination, dst, sizeof(dst))) return -1;
+#ifdef ANDROID
+    token = rr_jni_resolve_route(protocol, src, source_port, dst, destination_port);
+#else
+    if (!owner_callback) return -1;
+    token = owner_callback(protocol, src, source_port, dst, destination_port);
+#endif
+    /* Zero is only valid on the disabled legacy path. Java/JNI failure closes the flow. */
+    return token > 0 && (token & 65535) ? token : -1;
+}
